# HTTP
HTTP_PORT=8090

# Postgres — banco authdb, separado de orderdb/paymentdb, na mesma instância
# Postgres da stack do order-hub-application.
DATABASE_URL=postgres://orderdb:postgres@localhost:5433/authdb?sslmode=disable

# Par de chaves RSA usado pra assinar os access tokens (RS256). Se os arquivos não
# existirem, são gerados automaticamente no boot — não precisa criar na mão pra dev local.
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# TTLs
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=2592000

AUTH_ISSUER=orderhub-auth-service

# Protege POST /admin/users/bulk (usado pelo k6/create-users.sh pra provisionar
# usuários de teste em lote) — não é um sistema de admin de verdade, só uma chave
# compartilhada simples.
ADMIN_API_KEY=changeme-admin-key

# SMTP — usado por POST /auth/request-code pra enviar o código de 6 dígitos do
# login sem senha. Opcional: se SMTP_HOST ficar vazio, o código é só logado no
# stdout do serviço (suficiente pra testar o fluxo em dev local sem e-mail real).
# Mesma conta Gmail (com App Password) que o notification-service já usa serve aqui.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@orderhub.local

# Google OAuth — usado por GET /auth/oauth/google/start e
# POST /auth/oauth/google/callback. O client_secret fica só aqui: é este
# serviço que troca o code pelo token direto com o Google, não o
# order-hub-store. GOOGLE_REDIRECT_URI precisa bater, caractere por
# caractere, com o URI de redirecionamento cadastrado no Google Cloud
# Console, e aponta pro callback do order-hub-store (não deste serviço),
# porque é lá que o cookie de sessão httpOnly precisa ser gravado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
