# HTTP
HTTP_PORT=8090

# Postgres — banco authdb, separado de orderdb/paymentdb, na mesma instância
# Postgres da stack do order-hub-application.
DATABASE_URL=postgres://orderdb:postgres@localhost:5433/authdb?sslmode=disable

# Par de chaves RSA usado pra assinar os access tokens (RS256). Se os arquivos não
# existirem, são gerados automaticamente no boot — não precisa criar na mão pra dev local.
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# TTLs
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=2592000

AUTH_ISSUER=orderhub-auth-service

# Protege POST /admin/users/bulk (usado pelo k6/create-users.sh pra provisionar
# usuários de teste em lote) — não é um sistema de admin de verdade, só uma chave
# compartilhada simples.
ADMIN_API_KEY=changeme-admin-key
